{
  "name": "lessonreel",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Turn lesson notes into a narrated explainer video, even with no internet.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @lessonreel/web dev",
    "dev:lan": "pnpm --filter @lessonreel/web dev:lan",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ci": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build",
    "preview": "pnpm --filter @lessonreel/web preview"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1"
  }
}
