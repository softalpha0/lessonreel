# Copy to apps/web/.env.local and fill from Firebase console > Project settings > Your apps (Web).
# These are public client identifiers, not secrets. The Gemini API key never ships in the app:
# Firebase AI Logic proxies calls and App Check blocks anyone who is not your real app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Check (required by the hackathon). reCAPTCHA Enterprise site key for production.
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=
# Local dev only: set to "true" to print an App Check debug token in the console,
# then register it in Firebase console > App Check > Apps > Manage debug tokens.
VITE_APPCHECK_DEBUG=true

# Model names (keep them here or in Remote Config so a retired model is a config change, not a redeploy).
# gemini-3.1-flash-tts-preview shut down 2026-11-17; use the current TTS model from the Firebase docs.
VITE_CLOUD_TEXT_MODEL=gemini-3.5-flash-lite
VITE_TTS_MODEL=gemini-3.8-flash-tts
# Set to the current Gemini image-generation model listed in Firebase AI Logic docs. Leave empty to skip images.
VITE_IMAGE_MODEL=
